{
  "name": "dsh-transport-guard",
  "version": "0.1.0",
  "description": "区分「连接级瞬时故障」与「传输层 ~300 秒上限」，把 DeepSeek Messages transport failed 这句无法定位的兜底报错变成可归因、可自愈的失败",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "transport",
    "timeout",
    "retry"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "test:in-process": "node --test --test-isolation=none test/guard.test.mjs"
  },
  "license": "MIT",
  "author": "kakatata",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kakatata/dsh-transport-guard.git"
  },
  "homepage": "https://github.com/kakatata/dsh-transport-guard#readme",
  "bugs": {
    "url": "https://github.com/kakatata/dsh-transport-guard/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
